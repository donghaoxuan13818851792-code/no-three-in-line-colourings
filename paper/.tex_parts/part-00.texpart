  \paintrow{3}{4,4,3,2,3,2,1,1}
  \paintrow{2}{3,2,1,1,4,4,3,2}
  \paintrow{1}{2,4,2,4,1,3,1,3}
  \paintrow{0}{1,2,3,4,1,2,3,4}
  \finishgrid{8}
\end{tikzpicture}}

